# Единственный env-файл проекта для dev и production Compose.
# Production Compose использует DOMAIN/CADDY_EMAIL и принудительно отключает demo auth
# и seed; перед production deployment замените пароли, JWT secret и домен.

# ===== Public HTTPS / Caddy (только production) =====
# Полное DNS-имя без схемы и пути, например support.example.com. A/AAAA запись должна
# указывать на сервер; Caddy получает публичный TLS-сертификат автоматически.
DOMAIN=support.example.com
# Адрес для уведомлений Let's Encrypt, например ops@example.com.
CADDY_EMAIL=ops@example.com

# ===== PostgreSQL =====
# Непустое имя роли PostgreSQL, например molvest.
POSTGRES_USER=molvest
# Любая сильная случайная строка; production Compose не допускает пустое значение.
POSTGRES_PASSWORD=change-me-before-production
# Непустое имя базы данных, например molvest.
POSTGRES_DB=molvest
# Целое число от 1 до 65535; используется только dev Compose для публикации PostgreSQL.
POSTGRES_PORT=5432
# Целое число от 1 до 65535; используется только dev Compose для публикации FastAPI.
BACKEND_PORT=8000
# Целое число от 1 до 65535; используется только dev Compose для публикации Vite.
FRONTEND_PORT=5173
# Целое число от 1 до 65535; используется только dev Compose для Qdrant HTTP API.
QDRANT_HTTP_PORT=6333
# Целое число от 1 до 65535; используется только dev Compose для Qdrant gRPC API.
QDRANT_GRPC_PORT=6334

# ===== Demo access =====
# development, test или production. Оба Compose-файла задают свой режим явно.
ENVIRONMENT=development
# Непустая случайная строка. В production нельзя оставлять значение local-development-*.
JWT_SECRET=local-development-secret-change-in-production
# Целое число не меньше 1: время жизни JWT в минутах.
JWT_TTL_MINUTES=480
# true или false. Production Compose всегда устанавливает true.
AUTH_COOKIE_SECURE=false
# true или false. Production Compose всегда устанавливает false.
DEMO_AUTH_ENABLED=true

# ===== CORS =====
# Пусто для same-origin либо список origins через запятую, например https://admin.example.com.
# Wildcard * запрещён, потому что API использует cookie credentials. Dev Compose задаёт
# localhost origin самостоятельно.
CORS_ORIGINS=

# ===== SSE =====
# Положительное число секунд (дробное допустимо), например 15.
SSE_HEARTBEAT_SECONDS=15

# ===== Idle dialogs =====
# Положительное число часов (дробное допустимо), например 24 или 0.5.
DIALOG_IDLE_TIMEOUT_HOURS=24
# Положительное число секунд (дробное допустимо), например 300.
DIALOG_IDLE_SCAN_SECONDS=300

# ===== Storage =====
# local хранит файлы в named Docker volume; s3 использует S3-compatible storage и
# требует S3_ACCESS_KEY_ID и S3_SECRET_ACCESS_KEY ниже.
STORAGE_BACKEND=local
# URL S3 endpoint, например https://s3.example.com. Для AWS можно оставить пустым.
S3_ENDPOINT_URL=
# Регион S3, например us-east-1.
S3_REGION=us-east-1
# Непустое имя bucket, например molvest.
S3_BUCKET=molvest
# Учётные данные S3; обязательны при STORAGE_BACKEND=s3.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true или false: использовать HTTPS при подключении к S3 endpoint.
S3_USE_SSL=true

# ===== Startup data =====
# true или false. Production Compose всегда устанавливает false.
SEED_ON_STARTUP=true

# ===== Embedding =====
# cpu или cuda при доступном NVIDIA GPU; CPU является переносимым значением по умолчанию.
EMBEDDING_DEVICE=cpu

# ===== Qdrant =====
# HTTP(S) URL Qdrant. В Compose: http://qdrant:6333; для внешнего managed Qdrant — его URL.
QDRANT_URL=http://qdrant:6333

# ===== GigaChat =====
# Authorization Key из sber.creds; пустое значение отключает генерацию GigaChat.
GIGACHAT_CREDENTIALS=
# Scope, выданный для ключа, например GIGACHAT_API_PERS.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

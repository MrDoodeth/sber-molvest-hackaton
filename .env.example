# Единственный общий env-файл проекта.
# Compose читает его из корня для dev- и production-режимов.

# ===== PostgreSQL =====
POSTGRES_USER=molvest
POSTGRES_PASSWORD=molvest
POSTGRES_DB=molvest
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ===== Demo access =====
ENVIRONMENT=development
JWT_SECRET=local-development-secret-change-in-production
JWT_TTL_MINUTES=480
AUTH_COOKIE_SECURE=false
DEMO_AUTH_ENABLED=true

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173

# ===== SSE =====
SSE_HEARTBEAT_SECONDS=15

# ===== Idle dialogs =====
DIALOG_IDLE_TIMEOUT_HOURS=24
DIALOG_IDLE_SCAN_SECONDS=300

# ===== Storage =====
STORAGE_BACKEND=local

# ===== Startup data =====
SEED_ON_STARTUP=true

# ===== Embedding =====
EMBEDDING_DEVICE=cpu

# ===== Qdrant =====
QDRANT_URL=http://qdrant:6333

# ===== GigaChat =====
# GIGACHAT_CREDENTIALS=<Authorization Key из sber.creds>
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Development defaults for docker-compose.dev.yml.

# ===== PostgreSQL =====
POSTGRES_USER=molvest
POSTGRES_PASSWORD=molvest
POSTGRES_DB=molvest

# ===== Auth =====
JWT_SECRET=local-development-secret-change-in-production
JWT_TTL_MINUTES=480
AUTH_COOKIE_SECURE=false
DEMO_AUTH_ENABLED=true

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173

# ===== SSE =====
SSE_HEARTBEAT_SECONDS=15

# ===== Storage =====
STORAGE_BACKEND=local

# ===== Schema =====
CREATE_SCHEMA_ON_STARTUP=false
SEED_ON_STARTUP=true

# ===== Embedding =====
EMBEDDING_DEVICE=cpu

# ===== Qdrant =====
QDRANT_URL=http://qdrant:6333

# ===== GigaChat =====
# GIGACHAT_CREDENTIALS=<Authorization Key из sber.creds>
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
